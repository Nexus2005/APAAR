# Copy to .env and fill. NEVER commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# Postgres variant used by docker-compose:
# DATABASE_URL=postgresql+psycopg://apaar:apaar@db:5432/apaar

# 32+ char random strings. Production refuses the development defaults.
SESSION_SECRET=dev-session-secret-change-me-please
IDENTIFIER_HMAC_KEY=dev-hmac-key-change-me-0123456789
IDENTIFIER_ENCRYPTION_KEY=dev-fernet-key-change-me
PUBLIC_BASE_URL=http://localhost:8000

# LLM is optional and never decides. The whole product works with none.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=

# Seed synthetic data and demo accounts on startup.
DEMO_MODE=true
SEED_ON_STARTUP=true
VITE_API_URL=/api/v1
